{
	"extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
	"include": [
		"src/renderer/env.d.ts",
		"src/renderer/**/*",
		"src/renderer/**/*.tsx",
		"src/types/**/*",
		"src/api/**/*"
	],
	"compilerOptions": {
		"composite": true,
		"jsx": "react-jsx",
		"baseUrl": ".",
		"paths": {
			"~/*": ["src/renderer/*"],
			"~src/*": ["src/*"],
			"~types/*": ["src/types/*"]
		}
	}
}
