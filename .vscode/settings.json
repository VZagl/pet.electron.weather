{
	"[typescript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[javascript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[json]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},

	// region: костыль для Copilot
	// это костыль для того, чтобы Copilot не использовал 100% CPU.
	"terminal.integrated.gpuAcceleration": "off",

	// в окне вывода для TypeScript будут отображаться ошибки и пути к файлам логов
	// "typescript.tsserver.log": "verbose",
	// "typescript.tsserver.enableTracing": true,

	"files.exclude": {
		"**/.terragrunt-cache": true,
		"**/.cache": true,
		"**/node_modules": true,
		"**/vscode-chat-code-block": true // Добавлено исключение для временных файлов
	},
	"search.followSymlinks": false,
	"github.copilot.advanced": {
		"ignoredFiles": {
			"/node_modules/": true,
			"/dist/": true,
			"/build/": true,
			"/out/": true,
			"/*.min.js": true,
			"**/vscode-chat-code-block": true
		},
		"ignoredFolders": {
			"/node_modules": true,
			"/dist": true,
			"/build": true,
			"/out": true,
			"**/vscode-chat-code-block": true
		}
	}
	// endregion: костыль для Copilot
}
