{
	"[typescript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[javascript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[json]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},

	// region: костыль для Copilot
	// это костыль для того, чтобы Copilot не использовал 100% CPU.
	"files.exclude": {
		"**/.terragrunt-cache": true,
		"**/.cache": true,
		"**/node_modules": true
	},
	"search.followSymlinks": false,
	// "github.copilot.advanced": {
	// 	"files.exclude": {
	// 		"**/.terragrunt-cache": true,
	// 		"**/.cache": true,
	// 		"**/node_modules": true,
	// 		"**/dist": true,
	// 		"**/out": true,
	// 		"**/.qodo": true,
	// 		"**/build": true
	// 	}
	// }
	"github.copilot.advanced": {
		"ignoredFiles": {
			"/node_modules/": true,
			"/dist/": true,
			"/build/": true,
			"/out/": true,
			"/*.min.js": true
		},
		"ignoredFolders": {
			"/node_modules": true,
			"/dist": true,
			"/build": true,
			"/out/": true
		},
		"ignoredFilesGlob": ["/node_modules/", "/dist/", "/build/", "/out/", "/*.min.js"],
		"ignoredFoldersGlob": ["/node_modules", "/dist", "/build", "/out/"],
		"ignoredFilesRegex": ["node_modules", "dist", "build", "/out/", ".min.js"],
		"ignoredFoldersRegex": ["node_modules", "dist", "build", "/out/"],
		"ignoredFilesGlobRegex": ["node_modules", "dist", "build", "/out/", ".min.js"],
		"ignoredFoldersGlobRegex": ["node_modules", "dist", "build", "/out/"],
		"ignoredFilesGlobRegexArray": ["node_modules", "dist", "build", "/out/", ".min.js"],
		"ignoredFoldersGlobRegexArray": ["node_modules", "dist", "build", "/out/"],
		"ignoredFilesArray": ["/node_modules/", "/dist/", "/build/", "/out/", "/*.min.js"],
		"ignoredFoldersArray": ["/node_modules", "/dist", "/build", "/out/"],
		"ignoredFilesGlobArray": ["/node_modules/", "/dist/", "/build/", "/out/", "/*.min.js"],
		"ignoredFoldersGlobArray": ["/node_modules", "/dist", "/build", "/out/"],
		"ignoredFilesRegexArray": ["node_modules", "dist", "build", "/out/", ".min.js"],
		"ignoredFoldersRegexArray": ["node_modules", "dist", "build", "/out/"]
	},
	"CodeGPT.apiKey": "Ollama"
	// endregion: костыль для Copilot
}
